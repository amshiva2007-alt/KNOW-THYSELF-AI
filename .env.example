# Flask Server Configuration
PORT=5000
FLASK_ENV=development
DEBUG=True
SECRET_KEY=replace_with_your_own_secret_key

# Google Gemini API
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Firestore Configuration (Optional)
# Path to Firebase Service Account JSON file.
# If not configured, the app uses a resilient built-in JSON datastore for zero-friction local execution.
FIREBASE_CREDENTIALS_PATH=config/firebase-service-account.json
FIREBASE_PROJECT_ID=know-thyself-ai
